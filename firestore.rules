rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsRpg(rpgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rpgs/$(rpgId))
        && get(/databases/$(database)/documents/rpgs/$(rpgId)).data.autorId == request.auth.uid;
    }

    function isPublicRpg(rpgId) {
      return exists(/databases/$(database)/documents/rpgs/$(rpgId))
        && get(/databases/$(database)/documents/rpgs/$(rpgId)).data.publico == true;
    }

    function canReadRpg(rpgId) {
      return isPublicRpg(rpgId) || ownsRpg(rpgId);
    }

    match /rpgs/{rpgId} {
      allow read: if resource.data.publico == true
        || (signedIn() && resource.data.autorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.publico is bool;
      allow update: if signedIn()
        && resource.data.autorId == request.auth.uid
        && request.resource.data.autorId == resource.data.autorId
        && request.resource.data.publico is bool;
      allow delete: if signedIn()
        && resource.data.autorId == request.auth.uid;
    }

    match /personagens/{personagemId} {
      allow read: if canReadRpg(resource.data.rpgId);
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && canReadRpg(request.resource.data.rpgId);
      allow update: if signedIn()
        && (resource.data.usuarioId == request.auth.uid || ownsRpg(resource.data.rpgId))
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.rpgId == resource.data.rpgId;
      allow delete: if signedIn()
        && (resource.data.usuarioId == request.auth.uid || ownsRpg(resource.data.rpgId));
    }

    match /comentarios/{comentarioId} {
      allow read: if canReadRpg(resource.data.rpgId);
      allow create: if signedIn()
        && request.resource.data.autorUid == request.auth.uid
        && canReadRpg(request.resource.data.rpgId);
      allow delete: if signedIn()
        && (resource.data.autorUid == request.auth.uid || ownsRpg(resource.data.rpgId));
    }
  }
}
